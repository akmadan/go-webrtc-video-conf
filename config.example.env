PORT=8080
HOST=localhost
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Optional: require this token for websocket signaling auth.
# Client can pass via Authorization: Bearer <token> or ?token=<token>.
SIGNALING_TOKEN=
PUBLISH_SIGNALING_EVENTS_TO_LOG=false

# WebRTC ICE server config (returned from GET /ice-servers)
STUN_URLS=stun:stun.l.google.com:19302
TURN_ENABLED=false
TURN_URLS=turn:YOUR_PUBLIC_IP:3478?transport=udp,turn:YOUR_PUBLIC_IP:3478?transport=tcp
TURN_USERNAME=testuser
TURN_PASSWORD=testpassword
TURN_REALM=webrtc-local

# Distributed signaling with Redis pub/sub
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CHANNEL=go-webrtc-video-conf:events

# Runtime limits
MAX_PEERS_PER_ROOM=8
MAX_HTTP_PER_MINUTE=300
MAX_WS_MESSAGES_PER_SEC=30

